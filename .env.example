# =============================================================================
# Amazon RecSys v2 — Unified Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure the variables for your target environment.
# For Tier 0 local docker stack: see .env.tier0.example
# For Tier 1 free-tier cloud deployment: see .env.tier1.example

# -----------------------------------------------------------------------------
# 1. Google Gemini AI API (Query Rewriting & "Why This" Explanations)
# -----------------------------------------------------------------------------
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
MODEL_VERSION=v2.0

# -----------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Tier 1 Cloud (Neon): provide DATABASE_URL with sslmode=require
# Tier 0 Local: defaults to postgres://postgres:postgres@localhost:5432/recsys
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative individual fields for local PostgreSQL:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recsys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# 3. Cache Store (Redis / Upstash)
# -----------------------------------------------------------------------------
# Tier 1 Cloud (Upstash): provide REDIS_URL with rediss:// for TLS
# Tier 0 Local: defaults to redis://localhost:6379
REDIS_URL=rediss://default:your_upstash_password@xyz-12345.upstash.io:6379
# Alternative individual fields for local Redis:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
EXPLANATION_CACHE_TTL=86400

# -----------------------------------------------------------------------------
# 4. Vector Database (Qdrant Cloud / Local Qdrant)
# -----------------------------------------------------------------------------
# Tier 1 Cloud: provide QDRANT_URL and QDRANT_API_KEY
# Tier 0 Local: defaults to QDRANT_HOST=localhost, QDRANT_PORT=6333
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=products

# -----------------------------------------------------------------------------
# 5. Security & Service Settings
# -----------------------------------------------------------------------------
ADMIN_API_KEY=ds11_admin_secret_key_v2
PORT=8000
