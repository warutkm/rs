# =============================================================================
# Amazon RecSys v2 — Tier 1 Free Cloud Deployment Environment Template
# =============================================================================
# Architecture:
# - API Backend: FastAPI on Render Free Web Service
# - Frontend: Next.js 14 on Vercel Free Tier
# - Database: Neon Serverless PostgreSQL (0.5GB free)
# - Cache: Upstash Serverless Redis (10k cmds/day free)
# - Vector DB: Qdrant Cloud Cluster (1GB free)
# - LLM Layer: Google Gemini 3.5 Flash-Lite (Google AI API)

# -----------------------------------------------------------------------------
# 1. Google Gemini AI API
# -----------------------------------------------------------------------------
# Free/Pay-as-you-go key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
MODEL_VERSION=v2.0

# -----------------------------------------------------------------------------
# 2. Neon Serverless PostgreSQL
# -----------------------------------------------------------------------------
# Create project at https://neon.tech/
# Ensure ?sslmode=require is appended to the connection string
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 3. Upstash Serverless Redis
# -----------------------------------------------------------------------------
# Create database at https://upstash.com/
# Use rediss:// (TLS) protocol URL
REDIS_URL=rediss://default:your_upstash_password@xyz-12345.upstash.io:6379
EXPLANATION_CACHE_TTL=86400

# -----------------------------------------------------------------------------
# 4. Qdrant Cloud Managed Vector DB
# -----------------------------------------------------------------------------
# Create 1GB free tier cluster at https://cloud.qdrant.io/
# Generate an API key from the Cluster details page
# Sync vectors using: python pipeline/sync_embeddings.py
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=products

# -----------------------------------------------------------------------------
# 5. Admin & Retraining Security
# -----------------------------------------------------------------------------
# Secret token used to gate POST /admin/retrain and trigger pipeline runs
ADMIN_API_KEY=generate_a_secure_random_key_here
PORT=8000
